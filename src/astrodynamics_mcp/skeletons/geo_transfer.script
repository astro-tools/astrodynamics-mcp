% Description: Three-burn GEO insertion from a highly-elliptical inclined orbit: apogee raise (TOI), inclination + perigee correction (MCC), apogee lowering (MOI) -- all DC-targeted.

Create Spacecraft Sat
Sat.DateFormat                   = UTCGregorian
Sat.Epoch                        = '01 Jan 2026 00:00:00.000'
Sat.CoordinateSystem             = EarthMJ2000Eq
Sat.DisplayStateType             = Keplerian
Sat.SMA                          = 6578
Sat.ECC                          = 0.001
Sat.INC                          = 28.5
Sat.RAAN                         = 67
Sat.AOP                          = 355
Sat.TA                           = 250
Sat.DryMass                      = 850
Sat.Cd                           = 2.2
Sat.Cr                           = 1.8
Sat.DragArea                     = 15
Sat.SRPArea                      = 1

Create ForceModel AllForces
AllForces.CentralBody                      = Earth
AllForces.PrimaryBodies                    = {Earth}
AllForces.SRP                              = On
AllForces.ErrorControl                     = RSSStep
AllForces.GravityField.Earth.Degree        = 20
AllForces.GravityField.Earth.Order         = 20
AllForces.GravityField.Earth.PotentialFile = 'JGM2.cof'
AllForces.SRP.Flux                         = 1367
AllForces.Drag.AtmosphereModel             = MSISE90
AllForces.Drag.F107                        = 150
AllForces.Drag.F107A                       = 150
AllForces.Drag.MagneticIndex               = 3

Create Propagator DefaultProp
DefaultProp.FM                       = AllForces
DefaultProp.Type                     = PrinceDormand78
DefaultProp.InitialStepSize          = 60
DefaultProp.Accuracy                 = 1e-11
DefaultProp.MinStep                  = 0.001
DefaultProp.MaxStep                  = 86400
DefaultProp.MaxStepAttempts          = 50
DefaultProp.StopIfAccuracyIsViolated = true

Create ImpulsiveBurn TOI
TOI.CoordinateSystem   = Local
TOI.Origin             = Earth
TOI.Axes               = VNB
TOI.Isp                = 300
TOI.GravitationalAccel = 9.81

Create ImpulsiveBurn MCC
MCC.CoordinateSystem   = Local
MCC.Origin             = Earth
MCC.Axes               = VNB
MCC.Isp                = 300
MCC.GravitationalAccel = 9.81

Create ImpulsiveBurn MOI
MOI.CoordinateSystem   = Local
MOI.Origin             = Earth
MOI.Axes               = VNB
MOI.Isp                = 300
MOI.GravitationalAccel = 9.81

Create DifferentialCorrector DC
DC.ShowProgress      = true
DC.ReportStyle       = Normal
DC.MaximumIterations = 25
DC.DerivativeMethod  = ForwardDifference

Create ReportFile RF
RF.Filename = 'geo_transfer.txt'
RF.Add = {Sat.UTCGregorian, Sat.Earth.SMA, Sat.Earth.ECC, Sat.EarthMJ2000Eq.INC, Sat.Earth.RMAG}
RF.WriteHeaders = True

BeginMissionSequence

Propagate 'Prop to Z Crossing' DefaultProp(Sat) {Sat.Z = 0, StopTolerance = 1e-005}

Target 'Raise Apogee' DC {SolveMode = Solve, ExitMode = DiscardAndContinue}
   Vary 'Vary TOI.V' DC(TOI.Element1 = 1, {Perturbation = 0.0001, Lower = -9.999999e300, Upper = 9.999999e300, MaxStep = 0.5})
   Maneuver 'Apply TOI' TOI(Sat)
   Propagate 'Prop To Apogee' DefaultProp(Sat) {Sat.Apoapsis}
   Achieve 'Achieve RMAG' DC(Sat.RMAG = 85000, {Tolerance = 0.1})
EndTarget

Propagate 'Prop to Perigee' DefaultProp(Sat) {Sat.Earth.Periapsis}
Propagate 'Prop to Plane Crossing' DefaultProp(Sat) {Sat.Z = 0, StopTolerance = 1e-5}

Target 'Change Plane/Perigee' DC {SolveMode = Solve, ExitMode = DiscardAndContinue}
   Vary 'Vary MCC.V' DC(MCC.Element1 = 0.1, {Perturbation = 0.0001, Lower = -9.999999e300, Upper = 9.999999e300, MaxStep = 0.5})
   Vary 'Vary MCC.N' DC(MCC.Element2 = 0.1, {Perturbation = 0.0001, Lower = -9.999999e300, Upper = 9.999999e300, MaxStep = 0.5})
   Maneuver 'Apply MCC' MCC(Sat)
   Propagate 'Prop to Perigee' DefaultProp(Sat) {Sat.Periapsis}
   Achieve 'Apply INC' DC(Sat.EarthMJ2000Eq.INC = 2, {Tolerance = 0.001})
   % Perigee radius matches the GEO SMA so the final apoapsis-lowering
   % burn (next block) circularises the orbit instead of leaving a
   % perigee/apogee mismatch.
   Achieve 'Achieve RMAG' DC(Sat.RMAG = 42164.17, {Tolerance = 0.001})
EndTarget

Target 'Lower Apogee' DC {SolveMode = Solve, ExitMode = DiscardAndContinue}
   Vary 'Vary MOI.V' DC(MOI.Element1 = -0.1, {Perturbation = 0.0001, Lower = -9.999999e300, Upper = 9.999999e300, MaxStep = 0.1})
   Maneuver 'Apply MOI' MOI(Sat)
   Achieve 'Achieve SMA' DC(Sat.Earth.SMA = 42164.17, {Tolerance = 0.001})
EndTarget

Propagate 'Prop 10 days' DefaultProp(Sat) {Sat.ElapsedDays = 10}
