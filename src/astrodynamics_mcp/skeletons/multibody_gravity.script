% Description: Multibody spherical-harmonic gravity (Earth 12x12 + Luna 30x30 + Sun point-mass) propagating a near-rectilinear halo orbit (NRHO) in MoonMJ2000Eq.

Create CoordinateSystem MoonMJ2000Eq
MoonMJ2000Eq.Origin = Luna
MoonMJ2000Eq.Axes   = MJ2000Eq

Create Spacecraft Sat
Sat.DateFormat       = UTCGregorian
Sat.DisplayStateType = Cartesian
Sat.Epoch            = '1 Jun 2026 00:00:00.000'
Sat.CoordinateSystem = MoonMJ2000Eq
Sat.X                =  -8992.197
Sat.Y                =  17505.351
Sat.Z                = -61412.481
Sat.VX               = -0.04684787
Sat.VY               =  0.10867048
Sat.VZ               = -0.09986946
Sat.DryMass          = 130
Sat.Cd               = 2.2
Sat.Cr               = 1.8
Sat.DragArea         = 15
Sat.SRPArea          = 1

Create ForceModel FM
FM.CentralBody                      = Earth
FM.PrimaryBodies                    = {Earth, Luna}
FM.PointMasses                      = {Sun}
FM.GravityField.Earth.Degree        = 12
FM.GravityField.Earth.Order         = 12
FM.GravityField.Earth.TideModel     = 'None'
FM.GravityField.Earth.PotentialFile = 'EGM96.cof'
FM.GravityField.Luna.Degree         = 30
FM.GravityField.Luna.Order          = 30
FM.GravityField.Luna.PotentialFile  = 'grgm900c.cof'
FM.GravityField.Luna.TideModel      = 'None'
FM.SRP                              = Off
FM.ErrorControl                     = 'None'

Create Propagator Prop
Prop.Type            = RungeKutta89
Prop.FM              = FM
Prop.Accuracy        = 1e-13
Prop.InitialStepSize = 60
Prop.MinStep         = 0
Prop.MaxStep         = 600
Prop.MaxStepAttempts = 50

Create ReportFile RF
RF.Filename = 'multibody_gravity.txt'
RF.Add = {Sat.UTCGregorian, Sat.MoonMJ2000Eq.X, Sat.MoonMJ2000Eq.Y, Sat.MoonMJ2000Eq.Z, Sat.Luna.RMAG}
RF.WriteHeaders = True

BeginMissionSequence

Propagate Prop(Sat) {Sat.ElapsedDays = 30}
