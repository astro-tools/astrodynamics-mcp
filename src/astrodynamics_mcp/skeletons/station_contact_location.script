% Description: Ground-station contact-window report -- GroundStation + ContactLocator over a 5-day propagation; writes a per-event contact report.

Create Spacecraft LEOSat
LEOSat.DateFormat       = UTCGregorian
LEOSat.Epoch            = '01 Jan 2026 11:59:28.000'
LEOSat.CoordinateSystem = EarthMJ2000Eq
LEOSat.DisplayStateType = Keplerian
LEOSat.SMA              = 7191.938817629017
LEOSat.ECC              = 0.02454974900598101
LEOSat.INC              = 56.7
LEOSat.RAAN             = 306.6148
LEOSat.AOP              = 314.1906
LEOSat.TA               = 99.8877

Create GroundStation myStation
myStation.StateType = Spherical
myStation.Location1 = 28.5383355
myStation.Location2 = 278.6207635
myStation.Location3 = 0

Create ForceModel DefaultProp_ForceModel

Create Propagator DefaultProp
DefaultProp.FM = DefaultProp_ForceModel

Create ContactLocator ContactLocator1
ContactLocator1.Target               = LEOSat
ContactLocator1.Filename             = 'ContactLocator1.txt'
ContactLocator1.InputEpochFormat     = 'UTCGregorian'
ContactLocator1.InitialEpoch         = '01 Jan 2026 11:59:28.000'
ContactLocator1.StepSize             = 300
ContactLocator1.FinalEpoch           = '06 Jan 2026 11:59:28.000'
ContactLocator1.UseLightTimeDelay    = true
ContactLocator1.UseStellarAberration = true
ContactLocator1.WriteReport          = true
ContactLocator1.RunMode              = Automatic
ContactLocator1.UseEntireInterval    = true
ContactLocator1.Observers            = {myStation}
ContactLocator1.LightTimeDirection   = Transmit

Create ReportFile RF
RF.Filename = 'station_contact_location.txt'
RF.Add = {LEOSat.UTCGregorian, LEOSat.Earth.SMA, LEOSat.Earth.RMAG}
RF.WriteHeaders = True

BeginMissionSequence

Propagate DefaultProp(LEOSat) {LEOSat.ElapsedDays = 5}
